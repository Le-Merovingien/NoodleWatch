[imprimante]
# prusalink: the printer directly; connect: local Prusa Connect server (fill in [connect_local];
# hote, utilisateur and mot_de_passe are then unused)
api = prusalink
# printer address on the local network (printer screen: Settings > Network)
hote = 192.168.1.50
utilisateur = maker
# PrusaLink password (printer screen: Settings > Network > PrusaLink)
mot_de_passe = a-remplir
# false: observation mode, the alert is raised without pausing the print
pause = true

[camera]
# board camera: Synaptics' GStreamer pipeline (the sensor exposure is set at start-up);
# if the camera is not /dev/video0: v4l2-ctl --list-devices, then change device=
# Buddy3D camera: rtsp://camera-IP/live (RTSP enabled in the Prusa app),
# 720p recommended (1080p may take a lot of the board's CPU to decode, not measured yet);
# a video file or an image folder for a test
source = v4l2src device=/dev/video0 ! video/x-raw ! videoconvert ! video/x-raw,format=BGR ! appsink drop=true max-buffers=1
intervalle = 5
intervalle_repos = 30

[detection]
# npu on the board; sim (NPU simulator) or tflite for a test on a PC
materiel = npu
seuil = 0.18
# alert when n of the last m images contain spaghetti
n = 3
m = 5

[alerte]
# command run on alert (buzzer, HAT LEDs), empty = none
commande =
dossier = /home/root/printwatch-data/alertes

[prusa_connect]
# option: the box becomes a Prusa Connect camera (photos during the print, on alert and at the end).
# Token: Prusa Connect > printer > Camera > Add another camera. Empty = disabled.
jeton =
intervalle_connect = 60

[connect_local]
# with api = connect: local Prusa Connect server (github.com/prusa3d/prusa-connect) the printer is connected to
# server address, e.g. http://192.168.1.10:8080
url =
# API token with the operate scope: web app > Settings > API credentials > New credential
jeton =
# printer id on the server; empty = the server's only printer
imprimante =
# option: name of a push camera declared on the server for the printer; it gets the photos instead of
# [prusa_connect] (then leave its token empty). Empty = no photos
camera =

[journal]
# log file, rotated every night at midnight; empty = systemd journal only
fichier = /home/root/printwatch-data/printwatch.log
# after this many days, rotated logs and alert or end-of-print images are deleted (0 = never);
# images are only deleted when no print is running
jours = 14
