[Unit]
Description=PrintWatch, detection des spaghettis et pause PrusaLink
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/root
ExecStart=/home/root/printwatch-venv/bin/python -m printwatch /etc/printwatch.ini
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
